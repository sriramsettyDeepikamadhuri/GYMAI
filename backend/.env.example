# Local development defaults only. Fill these values for production deployment.
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@host:5432/gymai?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
CORS_ORIGINS=https://your-frontend-domain.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Google Apps Script email delivery (preferred for Gmail-based deployment)
GYMAI_EMAIL_SCRIPT_URL=
GYMAI_EMAIL_API_SECRET=

# Legacy SMTP settings kept for compatibility with older local environments only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

PASSWORD_RESET_EXPIRE_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60

# Security and scheduler
ADMIN_API_KEY=replace-with-a-long-random-admin-key
SCHEDULER_API_KEY=replace-with-a-long-random-scheduler-key
SCHEDULER_TIMEZONE=Asia/Kolkata
REMINDER_HOUR=21
REMINDER_MINUTE=0
REMINDER_ENABLED=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend-domain.onrender.com/api/auth/google/callback

# Registration and password reset flow
REGISTRATION_CODE_EXPIRE_MINUTES=10
REGISTRATION_RESEND_SECONDS=60

# Gemini AI planning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
